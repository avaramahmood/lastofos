# Copy to .env.local (never commit secrets)

# Turso: `turso db create last-of-os` then `turso db show last-of-os --url` / `turso db tokens create last-of-os`
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# Clerk (dashboard.clerk.com > your app > API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Random 32+ byte string: `openssl rand -base64 32`
SESSION_SECRET=

# Comma-separated emails that can open /admin
ADMIN_EMAILS=you@vitstudent.ac.in
